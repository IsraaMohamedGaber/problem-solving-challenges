   "source": [
    "def parity(n):\n",
    "\tremander = bool(n % 2)\n",
    "\tif remander == False:\n",
    "\t\treturn \"even\"\n",
    "\tif remander == True:\n",
    "\t\treturn \"odd\""
   ]
  },
